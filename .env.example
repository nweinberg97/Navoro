# Navoro configuration. Copy to .env (never commit it) or export these variables.
# Every setting is optional for local evaluation.

# Where the dashboard, API and SDK bundle are served. Used in install snippets.
# NAVORO_PUBLIC_ORIGIN=http://localhost:4400
# PORT=4400
# HOST=127.0.0.1

# development | production. Production requires NAVORO_SESSION_SECRET and disables the demo app.
# NODE_ENV=development

# Secret used to sign short-lived SDK session tokens (32+ random characters). Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NAVORO_SESSION_SECRET=

# SQLite database file.
# NAVORO_DATABASE_PATH=.data/navoro.db

# AI provider. Without a key Navoro runs in clearly labelled demo mode: answers are assembled
# from your retrieved documentation without a language model.
# ANTHROPIC_API_KEY=
# NAVORO_ANTHROPIC_MODEL=claude-sonnet-5-5

# Lumen demo customer app (separate origin, development only).
# NAVORO_SERVE_DEMO=true
# NAVORO_DEMO_PORT=4500

# Seed the synthetic demo workspace on first start (development only).
# NAVORO_SEED=true

# Allow importing documentation URLs that resolve to private/loopback addresses.
# Development only (lets you import the demo's http://localhost:4500/help/*.md). Refused in production.
# NAVORO_ALLOW_PRIVATE_URLS=true
